
1 ICON "app.ico"
1 24 "app.manifest.out"
1 VERSIONINFO
FILEVERSION @V1@,@V2@,@V3@,0
PRODUCTVERSION @V1@,@V2@,@V3@,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "0C0A04B0"
    BEGIN
      VALUE "CompanyName", "BlueShieldAA"
      VALUE "FileDescription", "BlueShieldAA"
      VALUE "FileVersion", "@VERSION@.0"
      VALUE "InternalName", "BlueShieldAA"
      VALUE "OriginalFilename", "BlueShieldAA.exe"
      VALUE "ProductName", "BlueShieldAA"
      VALUE "ProductVersion", "@VERSION@"
      VALUE "LegalCopyright", "BlueShieldAA. Licencia MIT."
      VALUE "Comments", "Consola de seguridad para Windows 10/11 (proyecto de código abierto)."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0C0A, 1200
  END
END
